# PromptBeast base pack. Original wording, every person an adult.
# Format: see promptbeast/core/forge/pack.py. Slots roll in `order`; `give` traits constrain later slots.
#
# Trait vocabulary used here
#   gender   f m nb
#   place    indoor outdoor urban nature water private public formal
#   climate  cold hot mild wet
#   clock    dawn day dusk night
#   outfit   casual formal winter swimwear sleepwear athletic

@pack id=base name="PromptBeast base" adults=false

